APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=n0glemand
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Seconds before Redis hands a reserved job out again. Must stay above Horizon's `instagram` supervisor
# timeout (900) and so above the login jobs' timeout (800), or a login waiting for its code runs twice.
# REDIS_QUEUE_RETRY_AFTER=1000

CACHE_STORE=database
HORIZON_PREFIX=n0glemand:horizon:
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
SLACK_SIGNING_SECRET=
# Slack user IDs (comma separated) allowed to run `/n0glemand instagram ...`.
# SLACK_ADMIN_USER_IDS=U0KA85C21
# YTDLP_BINARY=/usr/local/bin/yt-dlp
# YTDLP_COOKIES_PATH=/home/forge/cookies/instagram.txt

# Instagram credentials used server-side to log in and cache cookies for yt-dlp.
# Leave unset to fall back to YTDLP_COOKIES_PATH.
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
# How the login runs: http (default, plain requests) or browser (headless Chromium through
# resources/scripts/instagram-login, a persistent profile in storage/app/private/instagram-browser).
# INSTAGRAM_LOGIN_DRIVER=http
# Folder with node_modules/playwright and browsers/ (`npm ci` and `npx playwright install --only-shell chromium` run there).
# INSTAGRAM_BROWSER_DIR=/home/forge/n0glemand-browser
# INSTAGRAM_NODE_BINARY=node
# Seconds the browser login may take before the process is killed.
# INSTAGRAM_BROWSER_TIMEOUT=50
# sms or email: where an Instagram challenge page is asked to send its code.
# INSTAGRAM_CHALLENGE_METHOD=sms
# Seconds a login waits for a code (DM it to the bot or `/n0glemand instagram code <digits>`) or for an
# approval in the Instagram app. 0: a challenge ends the login as checkpoint_required.
# INSTAGRAM_CODE_WAIT=600
# Seconds the login lock lives: longer than the longest login (INSTAGRAM_BROWSER_TIMEOUT + INSTAGRAM_CODE_WAIT + 10 s stop grace).
# INSTAGRAM_LOGIN_LOCK_TTL=720
# A forced password login (after cookies were reported dead) happens at most this often, in seconds.
# INSTAGRAM_FORCE_FRESH_INTERVAL=21600
# INSTAGRAM_COOKIES_TTL=604800
# INSTAGRAM_LOGIN_COOLDOWN=300
# A stable reel URL: when the daily HTTP check cannot tell, yt-dlp reads it to confirm.
# INSTAGRAM_CHECK_URL=https://www.instagram.com/reel/XXXXXXXXXXX/

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_LOG_LEVEL=warning
# Set LOG_STACK explicitly to override the auto-detection. When SENTRY_LARAVEL_DSN is set,
# the stack default becomes "single,sentry" so warning+ logs fan out to Sentry automatically.
# LOG_STACK=single,sentry
